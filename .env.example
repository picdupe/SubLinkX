# Comma-separated exact browser origins allowed to call the API.
# Include scheme and port when non-default. Wildcards are not supported.
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:8081,http://127.0.0.1:8081

# Trusted reverse proxy/CDN IPs or CIDRs for client IP detection. Set this to
# the proxy addresses visible to the app (for example, 192.168.16.1 from Docker logs).
# Add CDN ranges only when the CDN connects directly to this app.
TRUSTED_PROXIES=

# Client source IP/CIDR allowlist. Empty permits loopback clients only.
# Example: ALLOWED_CLIENT_IPS=127.0.0.1,192.168.1.0/24,2001:db8::/32
ALLOWED_CLIENT_IPS=

# UID/GID for the non-root Docker process and bind-mounted directories.
SUBLINK_UID=10001
SUBLINK_GID=10001
